# Frontend (Vite) — optional; default is /api/submit on the same host as the app
# VITE_SUBMIT_API_URL=/api/submit
# VITE_SUBMIT_SECRET=same-value-as-SUBMIT_SECRET-below

# Supabase — Project Settings → API (anon public key only; never service_role in frontend)
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Vercel → Project → Settings → Environment Variables (never commit real values)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
# ALLOWED_ORIGIN=https://your-app.vercel.app
# SUBMIT_SECRET=optional-shared-secret
